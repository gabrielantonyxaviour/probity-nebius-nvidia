{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "probity-engine",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "probity", "database_id": "f34fb564-7b37-4214-8a8b-ed7cde1af5e1", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "4d7773f643c3448b8cd43406c2937fc7" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "probity-files" }],
  "workflows": [{ "name": "probity-check", "binding": "CHECK", "class_name": "CheckWorkflow" }],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["notifications@probity.larinova.com"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "EMAIL_FROM": "Probity <notifications@probity.larinova.com>",
    "SEC_USER_AGENT": "Probity vendor checks gabrielantony56@gmail.com",
    "APP_URL": "https://probity.pages.dev",
    "NEBIUS_PROJECT_ID": "project-e04yk83jbc00bwhyv60mbp"
  },
  "observability": { "enabled": true }
}
