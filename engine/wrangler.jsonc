{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "probity-engine",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "probity", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "probity-files" }],
  "workflows": [{ "name": "probity-check", "binding": "CHECK", "class_name": "CheckWorkflow" }],
  "triggers": { "crons": ["0 18 * * MON-FRI"] },
  "vars": { "SEC_USER_AGENT": "Probity hackathon demo probity-demo@example.com" },
  "observability": { "enabled": true }
}
